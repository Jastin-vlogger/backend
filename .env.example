SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=helpdesk@royalhorizon.group
SMTP_PASS=your-smtp-password
SMTP_FROM=helpdesk@royalhorizon.group
SUPPLIER_PORTAL_URL=http://localhost:3000/login
INVITE_PASSWORD_LENGTH=10
INTERNAL_API_KEY=shipment-internal-key

# AWS S3 Configuration (Required for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_SHIPMENT_PREFIX=shipments
# AWS_S3_PUBLIC_BASE_URL=https://your-custom-cdn-url.com (optional)
